{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build lesson",
            "type": "shell",
            "command": "make",
            "options": { "cwd": "${fileDirname}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run lesson in QEMU",
            "type": "shell",
            "command": "make run",
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": []
        }
    ]
}
